#!/bin/sh
# Pre-commit checks: no leaked secrets, no obviously-infringing media.
# Activated by install.sh (git config core.hooksPath .githooks). Runs on every commit.
set -eu
cd "$(git rev-parse --show-toplevel)"
fail=0

echo "pre-commit: scanning staged changes..."

# 1. Secrets — gitleaks if installed, otherwise a pattern-based fallback.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact -v || fail=1
else
  echo "  (gitleaks not installed — brew install gitleaks for a real scan; using a basic fallback)"
  staged="$(git diff --cached --name-only --diff-filter=ACM)"
  if [ -n "$staged" ]; then
    if echo "$staged" | xargs -I{} git diff --cached -- {} 2>/dev/null \
      | grep -nIE '(ghp_[A-Za-z0-9]{36}|sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'; then
      echo "  FAIL: looks like a secret/token in the diff above." >&2
      fail=1
    fi
  fi
fi

# 2. Copyright — this is a PUBLIC repo. Block known ripped-content filename patterns and
#    large unlicensed binary media. Reference-study images belong in the private
#    video-signature-lab repo, never here.
staged_files="$(git diff --cached --name-only --diff-filter=ACM)"
if [ -n "$staged_files" ]; then
  leaked="$(echo "$staged_files" | grep -iE 'vidssave|y2mate|savefrom|ytdl|yt-dlp.*\.(mp4|mov|mkv|webm)$' || true)"
  if [ -n "$leaked" ]; then
    echo "  FAIL: filename looks like ripped/downloaded video content, not something you made:" >&2
    echo "$leaked" | sed 's/^/    /' >&2
    fail=1
  fi
  big_media="$(echo "$staged_files" | grep -iE '\.(mp4|mov|mkv|png|jpe?g|gif|wav|mp3|ttf|otf|woff2?)$' || true)"
  if [ -n "$big_media" ]; then
    echo "$big_media" | while IFS= read -r f; do
      [ -f "$f" ] || continue
      size=$(stat -f%z "$f" 2>/dev/null || stat -c%s "$f" 2>/dev/null || echo 0)
      if [ "$size" -gt 200000 ]; then
        echo "  WARN: $f is $((size / 1024))KB — confirm you own it or it's properly licensed (references/assets.md's import checklist), this is a public repo." >&2
      fi
    done
  fi
fi

if [ "$fail" = "1" ]; then
  echo "pre-commit: BLOCKED. Fix the above, or git commit --no-verify to override (only if you're sure)." >&2
  exit 1
fi
echo "pre-commit: clean."
