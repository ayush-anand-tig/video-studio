# Which backend drafts the script/beat map and the scene (HTML/GSAP) code.
#
#   agent  (default) — whichever CLI is running this skill (Claude Code) writes it directly.
#                       Best quality, uses your Claude subscription, no setup needed.
#   local             — a local Ollama model writes a first draft instead, to save Claude
#                       tokens. You still review and tighten it before locking the script
#                       or shipping the scene — treat it as a rough draft, not final output.
PROVIDER=agent

# Only read when PROVIDER=local. Swap for any model you have pulled (`ollama list`).
LOCAL_SCRIPT_MODEL=qwen2.5:14b
LOCAL_CODE_MODEL=qwen2.5-coder:14b
