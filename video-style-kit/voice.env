# Which backend generates the voiceover, and which gets its word-level timestamps.
#
# TTS_PROVIDER:
#   say        (default) — macOS built-in `say`. Zero setup, works offline, robotic.
#   kokoro     — Kokoro-82M, Apache 2.0. Best quality-per-size local option; runs fine
#                on CPU/unified memory, no GPU needed — works on a MacBook Air, not just
#                a beefier Mac Mini. Needs: pip install kokoro-onnx (not installed by
#                default — this file doesn't trigger an install on its own).
#   kitten     — Kitten TTS nano (~24MB). Lighter than Kokoro if even that feels heavy.
#                Needs: pip install kittentts (not installed by default).
#   elevenlabs — cloud API, best quality, costs money. Needs ELEVENLABS_API_KEY in your
#                secrets file (see tools/tts.sh for where that's read from).
TTS_PROVIDER=say

# Which backend reads the resulting audio back to get word-level timestamps (step 3's
# "word timestamps" requirement, used to land Bridge/Ripple/Timeline on the right word).
#   none       (default) — no forced alignment; beats fall back to roughly even timing.
#   whisper    — needs: pip install faster-whisper (lightest Whisper variant that still
#                gives word-level timestamps; not installed by default).
TRANSCRIBE_PROVIDER=none

# Voice choice, only used by kokoro/kitten (say and elevenlabs have their own voice
# selection elsewhere — `say -v '?'` lists system voices; ElevenLabs voices are picked
# in their dashboard / via ELEVENLABS_VOICE_ID).
LOCAL_VOICE=af_heart
