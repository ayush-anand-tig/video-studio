# Which backend generates the voiceover, and which gets its word-level timestamps.
#
# TTS_PROVIDER:
#   say        (default) — macOS built-in `say`. Zero setup, works offline, robotic.
#   kokoro     — Kokoro-82M, Apache 2.0. Best-known quality-per-size local option; runs
#                fine on CPU/unified memory, no GPU needed — works on a MacBook Air, not
#                just a beefier Mac Mini. Needs: pip install kokoro-onnx soundfile, plus a
#                one-time ~350MB model download (tts.sh prints the exact commands if the
#                files aren't found at ~/.cache/kokoro). Voice catalog: 54 voices, e.g.
#                af_heart, af_bella, am_michael, bf_emma, bm_george — see tts.sh's error
#                output or kokoro-onnx's README for the full list.
#   phonon     — Gradium Phonon (31M English, Apache 2.0). Smaller than Kokoro, benchmarks
#                (vendor-published, no independent verification found) put it slightly
#                ahead on WER/listening tests. Larger/multilingual Phonon variants are
#                CC BY-NC (non-commercial) — stick to the 31M English model for this
#                project. Needs: pip install ptts (not installed by default). Voice
#                catalog: python3 -c "import ptts; print(ptts.catalog_voices())" once
#                installed, or see gradium.ai/phonon.
#   kitten     — Kitten TTS nano (~24MB). Lighter than either, if even those feel heavy.
#                Needs: pip install kittentts (not installed by default).
#   elevenlabs — cloud API, best quality, costs money. Needs ELEVENLABS_API_KEY in your
#                secrets file (see tools/tts.sh for where that's read from).
TTS_PROVIDER=say

# Which backend reads the resulting audio back to get word-level timestamps (Phase 2's
# "Lock timing" step, used to land Bridge/Ripple/Timeline on the right word).
#   none       (default) — no forced alignment; beats fall back to roughly even timing.
#   whisper    — needs: pip install faster-whisper (lightest Whisper variant that still
#                gives word-level timestamps; not installed by default).
TRANSCRIBE_PROVIDER=none

# Voice choice, used by kokoro (a name like af_heart) and phonon (a voice_id like
# 4SZHfMpw-p46Ywgs — phonon's IDs are opaque strings, not names; look up the name you
# want in its catalog first). say and elevenlabs have their own voice selection elsewhere
# (`say -v '?'` lists system voices; ElevenLabs voices are picked in their dashboard / via
# ELEVENLABS_VOICE_ID).
LOCAL_VOICE=af_heart

# kokoro/phonon/kitten need Python 3.10+. If `python3 --version` on your machine is older
# (common with the Xcode Command Line Tools' bundled Python), install a newer one (e.g.
# `brew install python@3.12`) into its own venv with the right packages, then point this
# at it — e.g. PYTHON_BIN=/path/to/venv/bin/python3. Leave unset to just use `python3`.
#PYTHON_BIN=
