# Where your signature comes from. One of:
#   SIGNATURE_SOURCE=default              # bundled Halo preset — most universal, recommended
#   SIGNATURE_SOURCE=preset:signal        # or preset:scanline — the other two bundled presets
#   SIGNATURE_SOURCE=local:./my-signature.json
#   SIGNATURE_SOURCE=local:/absolute/path/outside/this/repo/signature.json
#   SIGNATURE_SOURCE=github:someuser/their-repo:path/to/signature.json
#   SIGNATURE_SOURCE=github:someuser/their-repo@some-branch:path/to/signature.json
#   SIGNATURE_SOURCE=url:https://example.com/signature.json
#
# "local:" with a path outside this repo is how to use a private signature you don't
# want committed into a public project — point it at wherever you keep it.
SIGNATURE_SOURCE=default
